# Environment variables for Spend Compliance & Savings Monitor
# Copy to .env and adjust. All are optional; the defaults run the demo.

# Where data comes from: "fixture" (committed sample data) or "files" (CSV drop folder)
SPEND_SOURCE=fixture

# Folder the "files" source reads exports from. See docs/data-contract.md for the layout.
# SPEND_DATA_DIR=/srv/spend-monitor/inbox

# Pin a period (ISO week folder name) instead of using the most recent one.
# SPEND_PERIOD=2026-W38

# HTTP port
PORT=3000
